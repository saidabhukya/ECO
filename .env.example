# ==============================================================
# ECO TRACK — Environment Configuration Template
# ==============================================================

# Backend Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (set to 'auto' for zero-config embedded dev mode or provide Mongo Atlas URI)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster.mongodb.net/eco_track?retryWrites=true&w=majority
MONGODB_URI=auto

# JSON Web Token Secret & Expiration
JWT_SECRET=eco_track_change_this_to_a_long_cryptographically_secure_string_in_production
JWT_EXPIRE=7d

# Allowed Frontend URL for Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:5173

# Company Identity & Localization
COMPANY_NAME=ECO TRACK
COMPANY_TIMEZONE=UTC

# File Storage Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10
